<Window x:Class="SimpleGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleGame"
        mc:Ignorable="d"
        Title="Space Invaders" Height="600" Width="800">

    <Grid>
        <Canvas x:Name="GameCanvas" Background="Black" />

        <TextBlock x:Name="ScoreTextBlock" 
                   Text="Score: 0" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   Margin="10,10,0,0" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"/>
        <TextBlock x:Name="LivesTextBlock" 
            Text="Lives: 0" 
            FontSize="24" 
            FontWeight="Bold" 
            Foreground="White" 
            Margin="10,10,0,0" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Top"/>
    </Grid>
</Window>